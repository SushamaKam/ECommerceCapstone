{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
   // "moduleResolution": "node",
   "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["playwright.config.ts", "config/**/*.ts", "pages/**/*.ts", "fixtures/**/*.ts", "tests/**/*.ts", "utils/**/*.ts", "testdata/**/*.ts"]
}
